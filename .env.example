# Solo para el servidor Node (src/server.ts). El navegador nunca ve estas URLs: usa /api.
# Red privada de Railway (recomendado): http://<servicio-backend>.railway.internal:<PORT>
# o la URL pública del backend: https://<backend>.up.railway.app
API_BASE_URL=https://BACKEND.up.railway.app
PUBLIC_ORIGIN=https://FRONTEND.up.railway.app
# Hosts extra explícitos separados por coma, sin protocolo ni comodines.
NG_ALLOWED_HOSTS=
PUBLIC_CACHE_TTL_SECONDS=300
# Opcional: archivo JSON público en volumen persistente, nunca datos de pacientes.
PUBLIC_RESOURCES_FILE=content/recursos.json
PORT=4000
